# ---- Factory ----------------------------------------------------------
# Which product profile the factory builds. See src/factory/profiles.py.
FACTORY_PROFILE=java-springboot

# Model per role. Cost-conscious defaults: reasoner=sonnet,
# implementer=haiku, fallback=sonnet (used once when a call dies with an
# execution error). Set to an alias (opus/sonnet/haiku) or full model id.
# FACTORY_MODEL_REASONER=sonnet
# FACTORY_MODEL_IMPLEMENTER=haiku
# FACTORY_MODEL_FALLBACK=sonnet

# ---- Claude auth -------------------------------------------------------
# Preferred: `claude /login` with a Pro/Max subscription. No key needed.
# WARNING: if ANTHROPIC_API_KEY is set (even a stale one), it silently
# OVERRIDES subscription auth in non-interactive mode. If you hit auth
# errors, unset it: `unset ANTHROPIC_API_KEY`.
# ANTHROPIC_API_KEY=

# ---- Java (product builds) --------------------------------------------
# JDK 21+ is required to build the product. If `java` is not on PATH,
# point JAVA_HOME at a JDK, e.g.:
# JAVA_HOME=/Library/Java/JavaVirtualMachines/zulu-21.jdk/Contents/Home

# ---- Langfuse (optional observability) ---------------------------------
# These match the pre-seeded dev keys in docker-compose.langfuse.yml.
# If Langfuse is not running, the factory degrades to no-op tracing.
LANGFUSE_PUBLIC_KEY=pk-lf-factory-dev
LANGFUSE_SECRET_KEY=sk-lf-factory-dev
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_TRACING_ENABLED=true
